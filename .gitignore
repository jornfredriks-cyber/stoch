__pycache__/
.pytest_cache/
venv/
*.pyc
.DS_Store

# Generated run artifacts — everything in INPUT/ and OUTPUT/ (including its
# Screener/ and SweetSpot/ subfolders) is transient local data, never
# versioned. Only the folders themselves (via .gitkeep) are tracked.
INPUT/*
OUTPUT/*
!INPUT/.gitkeep
!OUTPUT/.gitkeep

# Personal watchlist export — local input data, not versioned
*Watchlist*
[Tt]radingview*
