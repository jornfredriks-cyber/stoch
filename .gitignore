# Generated run artifacts — everything in INPUT/ and OUTPUT/ is transient
# local data, never versioned. Only the folders themselves (via .gitkeep)
# are tracked.
INPUT/*
OUTPUT/*
!INPUT/.gitkeep
!OUTPUT/.gitkeep

